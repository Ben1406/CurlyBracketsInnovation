<Window x:Class="FortisFramework.MainWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:seqrib="clr-namespace:FortisFramework.UserControls.Internal.SequenceRibbon"
        xmlns:toolrib="clr-namespace:FortisFramework.UserControls.Internal.ToolRibbon"
        mc:Ignorable="d"
        Title="Fortis" Height="768" Width="1024" FontFamily="/FortisFramework;component/Fonts/Outfit.ttf#Outfit Regular">
    
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" Name="RibbonRow" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" Name="ToolRow"/>
        </Grid.RowDefinitions>
        <seqrib:SequenceRibbonControl x:Name="SequenceRibbon" Grid.Row="0" Grid.Column="0" Panel.ZIndex="9"/>
        <toolrib:ToolRibbonControl x:Name="ToolRibbon" Grid.Row="15" Grid.Column="0" Panel.ZIndex="8"/>
    </Grid>
</Window>
