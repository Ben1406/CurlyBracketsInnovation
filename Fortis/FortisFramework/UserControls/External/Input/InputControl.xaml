<UserControl x:Class="FortisFramework.UserControls.External.Input.InputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FortisFramework.UserControls.External.Input"
             xmlns:fortisframework="clr-namespace:FortisFramework"
             d:DataContext="{d:DesignInstance Type=local:InputControlViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="456" FontFamily="/FortisFramework;component/Fonts/Outfit.ttf#Outfit Regular">

    <Border Name="RootControl" Background="Transparent" BorderThickness="0" BorderBrush="White" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Name="HeaderLabel" Content="{Binding Path=HeaderText}" FontSize="12" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="16,2,2,2" Padding="0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"/>
            <Border Name="BorderBox" Background="Transparent" VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="7" BorderThickness="1" BorderBrush="White" CornerRadius="20"/>
            <Image Name="DropdownIcon" Source="{Binding Path=DropDownImagePath}" Visibility="{Binding Path=DropdownVisibility}" Stretch="Uniform" Height="24" Width="24" Grid.Row="1" Grid.Column="6" Grid.RowSpan="2" Margin="4"/>
            <TextBox Name="ValueBox" Text="{Binding Path=TypedValue, Mode=TwoWay}" FontSize="24" Background="Transparent" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="6" Padding="0" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="6" BorderThickness="0"/>
        </Grid>
    </Border>
</UserControl>
