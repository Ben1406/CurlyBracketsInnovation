<UserControl x:Class="FortisFramework.UserControls.Internal.ToolRibbon.ToolRibbonItemButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FortisFramework.UserControls.Internal.ToolRibbon"
             mc:Ignorable="d"
             x:ClassModifier="internal"
             d:DesignHeight="48" d:DesignWidth="54" FontFamily="/FortisFramework;component/Fonts/Poppins.ttf#Poppins Medium">

    <Border Name="RootControl" Background="Transparent" BorderThickness="0" BorderBrush="White" Margin="1" CornerRadius="0">
        <Grid Name="RibbonGrpButton">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Image Name="imgIcon" Visibility="Visible" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="2" Grid.Row="0" Grid.Column="1"/>
            <Label Name="lblDescription" Content="TEST" FontSize="8" Foreground="White" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" Grid.Row="1" Grid.ColumnSpan="3"/>
        </Grid>
    </Border>
</UserControl>
