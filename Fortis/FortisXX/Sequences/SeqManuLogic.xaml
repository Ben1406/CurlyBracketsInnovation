<seqbase:SequenceLogicBase x:Class="FortisXX.Sequences.SeqManuLogic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FortisXX.Sequences"
             xmlns:seqbase="clr-namespace:FortisFramework.UserControls.External;assembly=FortisFramework"
             xmlns:scale="clr-namespace:FortisFramework.UserControls.External.Scale;assembly=FortisFramework"
             xmlns:input="clr-namespace:FortisFramework.UserControls.External.Input;assembly=FortisFramework"
             mc:Ignorable="d" 
             d:DesignHeight="672" d:DesignWidth="1024">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label Name="Title" Content="MANUFACT" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.ColumnSpan="2" Foreground="Green"/>
        <input:InputControl Name="inpProduct" HeaderText="Product" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="1" IsDropdown="False"/>
        <input:InputControl Name="inpDepartment" HeaderText="Department" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" Grid.RowSpan="1" IsDropdown="False"/>
        <input:InputControl Name="inpStock" HeaderText="Stock" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4" Grid.RowSpan="1" IsDropdown="True"/>
        <input:InputControl Name="inpBatch" HeaderText="Batch" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="1" IsDropdown="True"/>
        <input:InputControl Name="inpLocation" HeaderText="Location" Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="1" IsDropdown="False"/>
        <scale:ScaleControl Name="Scale" Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3" Grid.RowSpan="2"/>
    </Grid>
</seqbase:SequenceLogicBase>
